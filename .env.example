# Required — any Postgres URL. Neon's copy-paste string (postgresql://…?sslmode=require&channel_binding=require)
# works as-is; it's normalised for asyncpg. Use the *pooled* Neon endpoint.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bbs

# Optional — every feature degrades gracefully without these
GOOGLE_PLACES_API_KEY=        # adds ratings/reviews; needs a billing account. Cap Places API (New) quota at 30 requests/day to stay $0
GEMINI_API_KEY=               # Google AI Studio free tier (no card)
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=                 # Groq free tier (no card), fallback LLM
GROQ_MODEL=openai/gpt-oss-120b      # llama-3.3-70b-versatile was retired by Groq (checked 2026-10-13)
PAGESPEED_API_KEY=            # free, 25k queries/day; without it "slow site" uses TTFB / page size
HUBSPOT_TOKEN=                # HubSpot free CRM private-app token: crm.objects.companies.read/write, crm.schemas.companies.write

# Crawler
CRAWL_CONCURRENCY=20
CRAWL_USER_AGENT="BuyBuildScoreBot/0.1 (+https://github.com/ShreyasManchanda/buy-build-score; contact: <your-email>)"
RUN_TIME_BUDGET_SECONDS=280

# Web / links
ALLOWED_ORIGINS=http://localhost:3000          # production: https://<your-app>.vercel.app
PUBLIC_APP_URL=http://localhost:3000           # base of the lead link pushed to HubSpot

# Tests only — a disposable database the integration tests TRUNCATE. Never your app database.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bbs_test

# web/.env.local (dev only): stream SSE straight from the API, bypassing the Next dev proxy
# NEXT_PUBLIC_STREAM_ORIGIN=http://localhost:8000
