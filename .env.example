# Required
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bbs   # Neon: use the pooled connection string

# Optional — every feature degrades gracefully without these
GOOGLE_PLACES_API_KEY=        # adds ratings/reviews; needs a billing account. Cap Places API (New) quota at 30 requests/day to stay $0
GEMINI_API_KEY=               # Google AI Studio free tier (no card)
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=                 # Groq free tier (no card), fallback LLM
GROQ_MODEL=llama-3.3-70b-versatile
PAGESPEED_API_KEY=            # free, 25k queries/day
HUBSPOT_TOKEN=                # HubSpot free CRM private-app token: crm.objects.companies.read/write, crm.schemas.companies.write

# Crawler
CRAWL_CONCURRENCY=20
CRAWL_USER_AGENT="BuyBuildScoreBot/0.1 (+https://github.com/ShreyasManchanda/buy-build-score; contact: <your-email>)"
RUN_TIME_BUDGET_SECONDS=280
ALLOWED_ORIGINS=http://localhost:3000
